-	ExecWait "$INSTDIR\${APP_EXECUTABLE_FILENAME} $R0" $0
+  ExecWait '"$INSTDIR\${APP_EXECUTABLE_FILENAME}" $R0' $0
   SetErrorLevel $0
+  Quit
 
-  SetOutPath $EXEDIR
-	RMDir /r $INSTDIR
+ExtractFailed:
+  SetOutPath "$EXEDIR"
+  System::Call 'kernel32::ReleaseMutex(p r9)'
+  System::Call 'kernel32::CloseHandle(p r9)'
+  MessageBox MB_OK|MB_ICONSTOP "lnwjing Portable runtime is incomplete or failed its integrity check. Close lnwjing, then remove only the affected lnwjing-runtime-v* or *.partial-* folder beside this EXE before retrying. Files have not been overwritten." /SD IDOK
+  SetErrorLevel 1
+  Quit
 SectionEnd
+
+# Hash all critical execution entry points against the build-time signed input.
+# This incurs bounded reads at launch but prevents reusing modified executables.
+Function VerifyCriticalFiles
+  ClearErrors
+  IfFileExists "$R4\${APP_EXECUTABLE_FILENAME}" 0 VerifyFailed
+  IfFileExists "$R4\resources\app.asar" 0 VerifyFailed
+  IfFileExists "$R4\resources\runtime-tools\ripgrep\rg.exe" 0 VerifyFailed
+  IfFileExists "$R4\resources\tunnel-client\tunnel-client.exe" 0 VerifyFailed
+  ${StdUtils.HashFile} $6 "SHA2-256" "$R4\${APP_EXECUTABLE_FILENAME}"
+  ${If} $6 != "${LNWJING_HASH_EXECUTABLE}"
+    Goto VerifyFailed
+  ${EndIf}
+  ${StdUtils.HashFile} $6 "SHA2-256" "$R4\resources\app.asar"
+  ${If} $6 != "${LNWJING_HASH_APP_ASAR}"
+    Goto VerifyFailed
+  ${EndIf}
+  ${StdUtils.HashFile} $6 "SHA2-256" "$R4\resources\runtime-tools\ripgrep\rg.exe"
+  ${If} $6 != "${LNWJING_HASH_RIPGREP}"
+    Goto VerifyFailed
+  ${EndIf}
+  ${StdUtils.HashFile} $6 "SHA2-256" "$R4\resources\tunnel-client\tunnel-client.exe"
+  ${If} $6 != "${LNWJING_HASH_TUNNEL}"
+    Goto VerifyFailed
+  ${EndIf}
+  Return
+VerifyFailed:
+  SetErrors
+FunctionEnd
