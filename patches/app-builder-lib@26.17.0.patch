+  StrCpy $INSTDIR "$EXEDIR\lnwjing-runtime-v${VERSION}-${UNPACK_DIR_NAME}"
 
-  StrCpy $INSTDIR "$PLUGINSDIR\app"
-  !ifdef UNPACK_DIR_NAME
-    StrCpy $INSTDIR "$TEMP\${UNPACK_DIR_NAME}"
-  !endif
+  # Cross-session mutex protects shared folders from concurrent extraction.
+  System::Call 'kernel32::CreateMutexW(p 0, i 0, w "Global\lnwjing-portable-${UNPACK_DIR_NAME}") p.r9'
+  ${If} $9 == 0
+    SetErrorLevel 1
+    Abort
+  ${EndIf}
+  System::Call 'kernel32::WaitForSingleObject(p r9, i 0xFFFFFFFF) i.r8'
+  ${If} $8 != 0
+  ${AndIf} $8 != 128
+    System::Call 'kernel32::CloseHandle(p r9)'
+    SetErrorLevel 1
+    Abort
+  ${EndIf}
 
-  RMDir /r $INSTDIR
-  SetOutPath $INSTDIR
+  # Do not operate inside an existing junction/symlink or any unknown folder.
+  System::Call 'kernel32::GetFileAttributesW(w "$INSTDIR") i.r4'
+  ${If} $4 != -1
+    IntOp $5 $4 & 0x400
+    ${If} $5 != 0
+      Goto ExtractFailed
+    ${EndIf}
+    IfFileExists "$INSTDIR\.lnwjing-ready" 0 ExtractFailed
+    StrCpy $R4 "$INSTDIR"
+    Call VerifyCriticalFiles
+    IfErrors ExtractFailed
+    Goto RunApp
+  ${EndIf}
 
+  # Each interrupted attempt leaves only a uniquely named *.partial-PID
+  # folder. Never erase an unknown folder or overwrite a live runtime.
+  System::Call 'kernel32::GetCurrentProcessId() i.r7'
+  StrCpy $R6 "$INSTDIR.partial-$7"
+  System::Call 'kernel32::GetFileAttributesW(w "$R6") i.r4'
+  ${If} $4 != -1
+    Goto ExtractFailed
+  ${EndIf}
+  CreateDirectory "$R6"
+  IfErrors ExtractFailed
+  SetOutPath "$R6"
+  IfErrors ExtractFailed
