[
  {
    "label": "lnwjing: Build + Verify Portable side-by-side (keep running EXE)",
    "command": "powershell.exe",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "scripts/build-portable-verified-windows-x64.ps1",
      "-SideBySide"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "lnwjing: Build + Verify + Publish Portable Windows x64",
    "command": "powershell.exe",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "scripts/build-portable-verified-windows-x64.ps1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "lnwjing: Build Portable x64 candidate (no publish)",
    "command": "powershell.exe",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "scripts/build-portable-windows-x64.ps1",
      "-SkipInstall",
      "-StageOnly"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "lnwjing: Verify + Publish existing Portable candidate",
    "command": "powershell.exe",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "scripts/build-portable-verified-windows-x64.ps1",
      "-PublishExistingStage"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  }
]
