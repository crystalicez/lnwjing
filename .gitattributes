# Keep integrity-verified source and generated expectations byte-stable across OS checkouts.
packages/capabilities/src/windows-capability-bridge.ps1 text eol=lf
packages/capabilities/src/windows-capability-integrity.generated.ts text eol=lf
*.sh text eol=lf
# Nested unified diffs require a literal space as the context-line prefix;
# do not flag those semantic prefixes as trailing whitespace on source commits.
patches/*.patch whitespace=-blank-at-eol
